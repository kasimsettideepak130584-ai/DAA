#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

const int INF = 1e9;

int totalCities;
vector<vector<int>> dist;
vector<vector<int>> dp;

int tsp(int mask, int u) {
    
    if (mask == (1 << totalCities) - 1) {
        return dist[u][0]; 
    }
    if (dp[mask][u] != -1) {
        return dp[mask][u];
    }

    int minCost = INF;
    for (int v = 0; v < totalCities; ++v) {
        
        if (!(mask & (1 << v))) {
            int newCost = dist[u][v] + tsp(mask | (1 << v), v);
            minCost = min(minCost, newCost);
        }
    }

    return dp[mask][u] = minCost;
}

int main() {
    cout << "Enter the number of cities: ";
    cin >> totalCities;

    dist.assign(totalCities, vector<int>(totalCities));
    
    dp.assign(1 << totalCities, vector<int>(totalCities, -1));

    cout << "Enter the distance matrix (" << totalCities << "x" << totalCities << "):\n";
    for (int i = 0; i < totalCities; ++i) {
        for (int j = 0; j < totalCities; ++j) {
            cin >> dist[i][j];
        }
    }

    int mask = 1;
    int minTourCost = tsp(mask, 0);

    if (minTourCost >= INF) {
        cout << "\nNo valid tour exists that visits all cities.\n";
    } else {
        cout << "\nMinimum cost of Travelling Salesman tour: " << minTourCost << "\n";
    }

    return 0;
}
