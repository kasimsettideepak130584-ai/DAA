#include <iostream>
#include <vector>
#include <queue>
#include <chrono>

using namespace std;
using namespace std::chrono;

class Graph {
    int V;
    vector<vector<int>> adj;

    void DFSUtil(int v, vector<bool> &visited) {
        visited[v] = true;
        cout << v << " ";
        for (int neighbor : adj[v])
            if (!visited[neighbor]) DFSUtil(neighbor, visited);
    }

public:
    Graph(int vertices) : V(vertices), adj(vertices) {}

    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u); // Undirected edge
    }

    void DFS(int start) {
        vector<bool> visited(V, false);
        DFSUtil(start, visited);
    }

    void BFS(int start) {
        vector<bool> visited(V, false);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        while (!q.empty()) {
            int node = q.front();
            q.pop();
            cout << node << " ";

            for (int neighbor : adj[node]) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push(neighbor);
                }
            }
        }
    }
};

int main() {
    int V, E, u, v, start;

    cout << "Enter number of vertices: ";
    cin >> V;
    Graph g(V);

    cout << "Enter number of edges: ";
    cin >> E;

    cout << "Enter edges (u v):\n";
    for (int i = 0; i < E; ++i) {
        cin >> u >> v;
        g.addEdge(u, v);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    // DFS timing
    cout << "\nDFS Traversal: ";
    auto startDFS = high_resolution_clock::now();
    g.DFS(start);
    auto stopDFS = high_resolution_clock::now();
    auto dfsTime = duration_cast<nanoseconds>(stopDFS - startDFS).count();

    // BFS timing
    cout << "\n\nBFS Traversal: ";
    auto startBFS = high_resolution_clock::now();
    g.BFS(start);
    auto stopBFS = high_resolution_clock::now();
    auto bfsTime = duration_cast<nanoseconds>(stopBFS - startBFS).count();

    // Output results
    cout << "\n\nExecution Time:";
    cout << "\nDFS: " << dfsTime << " ns";
    cout << "\nBFS: " << bfsTime << " ns\n";

    return 0;
}
